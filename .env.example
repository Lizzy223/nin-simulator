# Copy this file to .env and fill in your Supabase project values.

# Used by the browser app. Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Used only by `npm run db:upload` (never exposed to the browser).
# Supabase dashboard -> Connect -> Connection string -> URI (include your database password)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
